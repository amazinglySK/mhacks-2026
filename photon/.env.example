# Photon cloud credentials: set EITHER the project pair (tokens auto-renew)
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# ...OR one explicit cloud client (token is not auto-renewed)
PHOTON_ADDRESS=
PHOTON_TOKEN=
PHOTON_PHONE=

# Only this DM may drive the demo (Spectrum space id, e.g. any;-;+1555...)
DEMO_DM_ID=

# Photon's own Agentverse agent identity: a long random phrase, never shared
PHOTON_AGENT_SEED=
# Address of the hosted Reasoning Agent (agent1...)
REASONING_AGENT_ADDRESS=

# Only used by `bun run register` (one-time mailbox registration)
AGENTVERSE_API_KEY=
